<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
  <div style="text-align: left; flex: 1;">
    <h1 style="margin: 0 0 4px 0; text-align: left; line-height: 1;">{{ profile.personal_information.name }}</h1>
{% if resume.applying_for %}
    <div style="font-size: 1.1em; font-weight: bold; margin-bottom: 6px;">Applying for: {{ resume.applying_for }}</div>
{% endif %}
    <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 0.88em;">
      <span><span class="iconify" data-icon="tabler:phone"></span> {{ profile.personal_information.phone }}</span> |
      <span><span class="iconify" data-icon="tabler:mail"></span> <a href="mailto:{{ profile.personal_information.email }}">{{ profile.personal_information.email }}</a></span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 0.88em;">
      <span><span class="iconify" data-icon="tabler:brand-linkedin"></span> <a href="https://{{ profile.personal_information.linkedin }}">{{ profile.personal_information.linkedin }}</a></span> |
      <span><span class="iconify" data-icon="tabler:brand-github"></span> <a href="https://{{ profile.personal_information.github }}">{{ profile.personal_information.github }}</a></span>
    </div>
  </div>
{% if profile.photo and profile.photo.link %}
  <div style="margin-left: 16px;">
    <img src="{{ profile.photo.link }}" alt="Profile Photo"
         style="width: 80px; height: 100px; object-fit: cover;
                border: 1px solid #ccc; padding: 3px; background-color: white;">
  </div>
{% endif %}
</div>

{% if resume.objective %}

## PROFESSIONAL SUMMARY

{{ resume.objective }}
{% endif %}
{% if profile.education %}

## EDUCATION
{% for edu in profile.education %}

**{{ edu.degree }}**
~ {{ edu.institution }}
~ {{ edu.duration }}
{% endfor %}
{% endif %}

{% if resume.skills %}

## SKILLS
<table style="width: 100%; border-collapse: collapse; margin-top: 5px;">
{% for skill_group in resume.skills %}
  <tr>
    <td style="font-weight: bold; width: 28%; vertical-align: top; padding: 1px 0;">{{ skill_group.category }}</td>
    <td style="vertical-align: top; padding: 1px 0;">{{ skill_group.items | join(', ') }}</td>
  </tr>
{% endfor %}
</table>
{% endif %}

{% if resume.projects %}

## PROJECTS
{% for project in resume.projects %}
{% set project_link = (project.link or '') | trim %}

{% if project.github_path and project_link %}
**{{ project.name }}** | [{{ project.github_path }}]({{ project_link if project_link.startswith('http') else 'https://' + project_link }})
{% elif project_link %}
**{{ project.name }}** | [{{ project_link | replace('https://', '') | replace('http://', '') | replace('www.', '') }}]({{ project_link if project_link.startswith('http') else 'https://' + project_link }})
{% else %}
**{{ project.name }}**
{% endif %}

{{ project.description }}
{% endfor %}
{% endif %}
{% if resume.experience %}

## EXPERIENCE
{% for exp in resume.experience %}

**{{ exp.role }}**
~ {{ exp.duration }}
{{ exp.organization }}
~ {{ exp.location }}
{% for bullet in exp.bullets %}
- {{ bullet }}
{% endfor %}
{% endfor %}
{% endif %}
{% if resume.activities %}

## EXTRA-CURRICULAR ACTIVITIES & ACHIEVEMENTS
{% for activity in resume.activities %}

**{{ activity.topic }}**
{% for bullet in activity.bullets %}
- {{ bullet }}
{% endfor %}
{% endfor %}
{% endif %}
